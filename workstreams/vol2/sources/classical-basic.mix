# TAOCP 3rd ed. vol.2, pp.267-270,623-625.
# Source-line IDs retained, local numeric labels renamed only.
# S08 includes the published 2000 correction W -> W+N.
# MN is M*N, supplied by the driver. Each END label is fall-through stop.
CLA01 A ENN1 N
CLA02 - JOV OFLO
CLA03 A1 ENTA 0
CLA04 - J1Z A3
CLA05 A2 ADD U+N,1
CLA06 - ADD V+N,1
CLA07 - STA W+N,1
CLA08 - INC1 1
CLA09 - JNOV A1
CLA10 - ENTA 1
CLA11 - J1N A2
CLA12 A3 STA W+N
CLAend A_END CON 0
CLS01 S ENN1 N
CLS02 - JOV OFLO
CLS03 S1 J1Z S_END
CLS04 - ENTA 1
CLS05 S2 ADD U+N,1
CLS06 - SUB V+N,1
CLS07 - ADD WM1
CLS08 - STA W+N,1
CLS09 - INC1 1
CLS10 - JOV S1
CLS11 - ENTA 0
CLS12 - J1N S2
CLS13 - HLT 5
CLSend S_END CON 0
CLM01 PM ENT1 M-1
CLM02 - JOV OFLO
CLM03 - STZ W,1
CLM04 - DEC1 1
CLM05 - J1NN *-2
CLM06 - ENN2 N
CLM07 M1 LDX V+N,2
CLM08 - JXZ M8
CLM09 - ENN1 M
CLM10 - ENT3 N,2
CLM11 - ENTX 0
CLM12 M2 STX CARRY
CLM13 - LDA U+M,1
CLM14 - MUL V+N,2
CLM15 - SLC 5
CLM16 - ADD W,3
CLM17 - JNOV *+2
CLM18 - INCX 1
CLM19 - ADD CARRY
CLM20 - JNOV *+2
CLM21 - INCX 1
CLM22 - STA W,3
CLM23 - INC1 1
CLM24 - INC3 1
CLM25 - J1N M2
CLM26 M8 STX W+M+N,2
CLM27 - INC2 1
CLM28 - J2N M1
CLMend PM_END CON 0
CL303 C3 ENN1 N
CL304 - JOV OFLO
CL305 - ENTX 0
CL306 C32 SLAX 5
CL307 - ENT3 MN,1
CL308 C33 ADD U,3
CL309 - JNOV *+2
CL310 - INCX 1
CL311 - DEC3 N
CL312 - J3NN C33
CL313 - STA W+N,1
CL314 - INC1 1
CL315 - J1N C32
CL316 - STX W+N
CL3end C3_END CON 0
CL801 C8 ENT1 N-1
CL802 - JOV OFLO
CL803 - STZ W+N
CL804 C82 LDA U,1
CL805 - ADD V,1
CL806 - STA W,1
CL807 - JNOV C84
CL808 - ENT2 1,1
CL809 C83 LDA W,2
CL810 - INCA 1
CL811 - STA W,2
CL812 - INC2 1
CL813 - JOV C83
CL814 C84 DEC1 1
CL815 - J1NN C82
CL8end C8_END CON 0
CL1301 C13 ENN1 N
CL1302 - JOV OFLO
CL1303 - ENTX 0
CL1304 C132 STX CARRY
CL1305 - LDA U+N,1
CL1306 - MUL V
CL1307 - SLC 5
CL1308 - ADD CARRY
CL1309 - JNOV *+2
CL1310 - INCX 1
CL1311 - STA W+N,1
CL1312 - INC1 1
CL1313 - J1N C132
CL1314 - STX W+N
CL13end C13_END CON 0
CONST1 WM1 CON WORDMINUS1
CONST2 CARRY CON 0
TRAP OFLO HLT 99
