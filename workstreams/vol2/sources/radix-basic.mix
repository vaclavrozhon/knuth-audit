# Vol.2 pp.320–323,636. Unique labels replace numeric local labels.
# END labels stop fall-through, not instructions from the book.
# E8 is the original; E8FIX adds a current-input store and rounds 1/10 up.
R101 R1 ENT1 0
R102 - LDX U
R103 - ENTA 0
R104 R1LOOP DIV =10=
R105 - STX ANSWER,1
R106 - INC1 1
R107 - SRAX 5
R108 - JXP R1LOOP
R1end R1_END CON 0
R401 R4 JOV OFLO
R402 - LDA U
R403 - LDX C
R404 - DIV D
R405 - JOV ERROR
R406 - ENT1 N-1
R407 R4LOOP MUL =10=
R408 - STA ANSWER,1
R409 - SLAX 5
R410 - DEC1 1
R411 - J1NN R4LOOP
R4end R4_END CON 0
R601 R6 ENT1 M-1
R602 - LDA INPUT+M
R603 R6LOOP MUL =10=
R604 - SLAX 5
R605 - ADD INPUT,1
R606 - DEC1 1
R607 - J1NN R6LOOP
R6end R6_END CON 0
E801 E8 ENT1 0
E802 - LDA U
E803 E8LOOP MUL =1//10=
E804 E8RETRY STA TEMP
E805 - MUL =-10=
E806 - SLAX 5
E807 - ADD U
E808 - JANN E8DIGIT
E809 - LDA TEMP
E810 - DECA 1
E811 - JMP E8RETRY
E812 E8DIGIT STA ANSWER,1
E813 - LDA TEMP
E814 - INC1 1
E815 - JAP E8LOOP
E8end E8_END CON 0
F801 E8FIX ENT1 0
F802 - LDA U
F803 E8FIXLOOP STA CURRENT
F804 - MUL =1//10+1=
F805 E8FIXRETRY STA TEMP
F806 - MUL =-10=
F807 - SLAX 5
F808 - ADD CURRENT
F809 - JANN E8FIXDIGIT
F810 - LDA TEMP
F811 - DECA 1
F812 - JMP E8FIXRETRY
F813 E8FIXDIGIT STA ANSWER,1
F814 - LDA TEMP
F815 - INC1 1
F816 - JAP E8FIXLOOP
F8end E8FIX_END CON 0
DATA1 TEMP CON 0
DATA2 CURRENT CON 0
TRAP1 OFLO HLT 99
TRAP2 ERROR HLT 98
